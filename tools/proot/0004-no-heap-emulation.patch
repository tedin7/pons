 void translate_brk_enter(Tracee *tracee)
 {
 	word_t new_brk_address;
 	size_t old_heap_size;
 	size_t new_heap_size;
 
-	if (tracee->heap->disabled)
+	if (tracee->heap->disabled || heap_emulation_disabled())
 		return;
 
 	if (heap_offset == 0) {
@@ -153,7 +168,7 @@
 	word_t sysnum;
 	int tracee_errno;
 
-	if (tracee->heap->disabled)
+	if (tracee->heap->disabled || heap_emulation_disabled())
 		return;
 
 	assert(heap_offset > 0);
