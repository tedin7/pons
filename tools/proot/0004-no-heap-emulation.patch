  * can be reproduced when using a Ubuntu 12.04 x86_64 rootfs on RHEL 5
  * x86_64.
  */
+/* Pons: PROOT_NO_HEAP leaves brk(2) to the kernel.  The emulated heap resizes an
+ * mmap()ed region in place with mremap(2); when glibc trims it and something gets
+ * mapped right behind it, the in-place growth that follows diverges from what a
+ * real brk(2) does, and malloc ends up reporting corruption.  It also costs a
+ * ptrace stop per brk(2).  */
+bool heap_emulation_disabled(void)
+{
+	static int disabled = -1;
+	if (disabled < 0)
+		disabled = getenv("PROOT_NO_HEAP") != NULL;
+	return disabled;
+}
