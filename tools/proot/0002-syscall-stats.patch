+/* Diagnostic: per-syscall counters of the sysenter stops handled by PRoot,
+ * enabled only when PROOT_SYSCALL_STATS=<file> is set in PRoot's own
+ * environment.  PRoot is single-threaded: no locking.  The table is written
+ * (overwritten) every 10 seconds and at exit, as "name count seccomp ptrace"
+ * lines sorted by count, plus a "total" line.  */
+#define STATS_MAX_NR 1024
+#define STATS_PERIOD_S 10
+#define STATS_CHECK_EVERY 1024
+
+int proot_stats_via_seccomp = 0;
+
+static const char *stats_file = NULL;
+static int stats_state = 0; /* 0: not initialized, 1: enabled, -1: disabled.  */
+static unsigned long stats_total[STATS_MAX_NR + 1];
+static unsigned long stats_seccomp[STATS_MAX_NR + 1];
+static const char *stats_name[STATS_MAX_NR + 1];
+static unsigned long stats_stops = 0;
+static time_t stats_last_dump = 0;
+
+static int stats_compare(const void *a, const void *b)
+{
+	unsigned long ca = stats_total[*(const int *) a];
+	unsigned long cb = stats_total[*(const int *) b];
+	return (ca < cb) - (ca > cb);
+}
+
+static void stats_dump(void)
+{
+	static int order[STATS_MAX_NR + 1];
+	unsigned long total = 0, total_seccomp = 0;
+	int count = 0;
+	FILE *file;
+	int i;
+
+	file = fopen(stats_file, "w");
+	if (file == NULL)
+		return;
+
+	for (i = 0; i <= STATS_MAX_NR; i++) {
+		if (stats_total[i] == 0)
+			continue;
+		order[count++] = i;
+		total += stats_total[i];
+		total_seccomp += stats_seccomp[i];
+	}
+	qsort(order, count, sizeof(order[0]), stats_compare);
+
+	for (i = 0; i < count; i++) {
+		int nr = order[i];
+		const char *name = stats_name[nr];
+		char fallback[32];
+
+		if (name == NULL || name[0] == '\0') {
+			snprintf(fallback, sizeof(fallback), "nr%d", nr);
+			name = fallback;
+		}
+		if (nr == STATS_MAX_NR)
+			name = "other";
+		fprintf(file, "%s %lu seccomp=%lu ptrace=%lu\n", name, stats_total[nr],
+			stats_seccomp[nr], stats_total[nr] - stats_seccomp[nr]);
+	}
+	fprintf(file, "total %lu seccomp=%lu ptrace=%lu\n", total, total_seccomp,
+		total - total_seccomp);
+	fclose(file);
+}
+
+static void stats_count(Tracee *tracee)
+{
+	unsigned long nr;
+	struct timespec now;
+
+	if (stats_state == 0) {
+		stats_file = getenv("PROOT_SYSCALL_STATS");
+		if (stats_file == NULL || stats_file[0] == '\0') {
+			stats_state = -1;
+			return;
+		}
+		stats_state = 1;
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		stats_last_dump = now.tv_sec;
+		atexit(stats_dump);
+	}
+
+	nr = (unsigned long) peek_reg(tracee, ORIGINAL, SYSARG_NUM);
+	if (nr >= STATS_MAX_NR)
+		nr = STATS_MAX_NR;
+	stats_total[nr]++;
+	if (proot_stats_via_seccomp)
+		stats_seccomp[nr]++;
+	if (stats_name[nr] == NULL)
+		stats_name[nr] = stringify_sysnum(get_sysnum(tracee, ORIGINAL));
+
+	if (++stats_stops % STATS_CHECK_EVERY == 0) {
+		clock_gettime(CLOCK_MONOTONIC, &now);
+		if (now.tv_sec - stats_last_dump >= STATS_PERIOD_S) {
+			stats_last_dump = now.tv_sec;
+			stats_dump();
+		}
+	}
+}
