#!/bin/sh
# Stand-in for lsof, installed over /usr/bin/lsof (the real one is kept as lsof.real).
#
# Steam accepts its web UI's local websocket only after `lsof -P -F upnR -i TCP@addr`
# names the connecting process. Android forbids apps to read /proc/net/tcp, so the
# real lsof sees nothing and Steam rejects its own UI (error 0x3008). Inside
# Pinguplay's sandbox the only local client of Steam's transport is its web helper,
# so when the real lsof has no answer we report that process.
set -u
REAL=/usr/bin/lsof.real
[ -n "${PINGUPLAY_LSOF_LOG:-}" ] && echo "$(date +%T.%N) lsof $*" >> "$PINGUPLAY_LSOF_LOG"
if [ -r /proc/net/tcp ]; then
    exec "$REAL" "$@"
fi

query=""
for arg in "$@"; do
    case "$arg" in TCP@*) query=${arg#TCP@} ;; esac
done
[ -n "$query" ] || exit 1

# Exact answer when libpinguplay-robust.so saw the connection being made. Steam can
# ask before the client has written its entry, so wait up to half a second.
port=${query##*:}
entry=/tmp/.pinguplay-sockets/$port
tries=0
while [ ! -r "$entry" ] && [ "$tries" -lt 10 ]; do
    sleep 0.05
    tries=$((tries + 1))
done
if [ -r "$entry" ]; then
    read -r pid ppid lport rport < "$entry"
    if [ -d "/proc/$pid" ]; then
        printf 'p%s\nR%s\nu%s\nf0\nn127.0.0.1:%s->127.0.0.1:%s\n' "$pid" "$ppid" "$(id -u)" "$lport" "$rport" |
            tee -a "${PINGUPLAY_LSOF_LOG:-/dev/null}"
        exit 0
    fi
fi

# Chromium opens sockets from its network service, a child of the web helper's
# browser process; Steam checks that parent, so report the network service and
# fall back to the browser process if there is none.
report() {
    ppid=$(sed 's/.*) //' "/proc/$1/stat" | cut -d' ' -f2)
    printf 'p%s\nR%s\nu%s\nf0\nn%s->127.0.0.1:0\n' "$1" "$ppid" "$(id -u)" "$query" |
        tee -a "${PINGUPLAY_LSOF_LOG:-/dev/null}"
    exit 0
}
browser=""
# One grep over all command lines: a fork per process is far too slow under proot,
# and Steam's UI thread waits for this answer.
for file in $(grep -l -a steamwebhelper /proc/[0-9]*/cmdline 2>/dev/null); do
    dir=${file%/cmdline}
    cmd=$(tr '\0' ' ' < "$file" 2>/dev/null) || continue
    case "$cmd" in
        *steamwebhelper*network.mojom.NetworkService*) report "${dir#/proc/}" ;;
        *steamwebhelper*--type=*) ;;
        *steamrtarm64/steamwebhelper*) browser=${dir#/proc/} ;;
    esac
done
[ -n "$browser" ] && report "$browser"
exit 1
