#!/bin/sh
# pons-game <profile | Steam app id> [game arguments...]
# Starts a game and freezes Steam's web interface while it runs
# (PONS_STEAM_FREEZE=0 keeps it running).
# - A profile, /opt/pons/games/<name>.conf (also found by its STEAM_APPID), runs the
#   game's program directly with tuned settings (frame cap, file fast path).
# - Any other installed Steam game is started by Steam itself, as on a Linux PC.
set -u
WHICH="${1:?usage: pons-game <profile | Steam app id> [game arguments]}"; shift
NAME= STEAM_APPID= DIR= EXEC= ARGS= MAX_FPS=
CONF="/opt/pons/games/$WHICH.conf"
[ -f "$CONF" ] || CONF=$(grep -l -x "STEAM_APPID=\"$WHICH\"" /opt/pons/games/*.conf 2>/dev/null | head -n 1)
if [ -n "$CONF" ]; then
    . "$CONF"
else
    case "$WHICH" in *[!0-9]*) echo "Unknown game: $WHICH" >&2; exit 1 ;; esac
    STEAM_APPID=$WHICH
fi

STEAM="$HOME/.local/share/Steam"
if [ -z "$EXEC" ]; then
    MANIFEST="$STEAM/steamapps/appmanifest_$STEAM_APPID.acf"
    acf() { sed -n "s/^[[:space:]]*\"$1\"[[:space:]]*\"\(.*\)\"[[:space:]]*\$/\1/p" "$MANIFEST" 2>/dev/null | head -n 1; }
    NAME=$(acf name) INSTALLDIR=$(acf installdir)
    [ -n "$INSTALLDIR" ] || { echo "Steam game $STEAM_APPID is not installed: install it from Steam." >&2; exit 1; }
else
    GAME="$STEAM/steamapps/common/$DIR"
    [ -x "$GAME/$EXEC" ] || { echo "$NAME is not installed: install it from Steam." >&2; exit 1; }
fi

# Steam already running and signed in (started ahead by the app, or by an earlier
# game in this session): its last connection state line says "Logged On".
# A "Logged On" left in the log by an earlier run does not count: the log must have
# been written after this steam process started.
steam_signed_in() {
    log="$STEAM/logs/connection_log.txt"
    for f in /proc/[0-9]*/comm; do
        [ "$(cat "$f" 2>/dev/null)" = steam ] || continue
        [ "$(stat -c %Y "$log" 2>/dev/null || echo 0)" -ge "$(stat -c %Y "${f%/comm}")" ] || return 1
        tail -n 200 "$log" | grep -o '\] \[[A-Z][A-Za-z ]*,' | tail -n 1 | grep -q 'Logged On'
        return
    done
    return 1
}

if [ -n "$STEAM_APPID" ] && steam_signed_in; then
    echo "Steam is already signed in."
    export SteamAppId="$STEAM_APPID" SteamGameId="$STEAM_APPID"
elif [ -n "$STEAM_APPID" ]; then
    LOG="$STEAM/logs/connection_log.txt"
    echo "Starting Steam…"
    start_lines=$(wc -l < "$LOG" 2>/dev/null || echo 0)
    pons-steam -silent > /tmp/pons-steam.log 2>&1 &
    echo "Waiting for your Steam account to sign in…"
    waited=0
    until tail -n +"$((start_lines + 1))" "$LOG" 2>/dev/null | grep -q "\[Logged On"; do
        sleep 2
        waited=$((waited + 2))
        if [ "$waited" -ge 300 ]; then
            echo "Steam did not sign in within 5 minutes: open Steam and sign in." >&2
            exit 1
        fi
    done
    export SteamAppId="$STEAM_APPID" SteamGameId="$STEAM_APPID"
fi

# Steam's web interface (steamwebhelper, a Chromium) keeps ~0.5 GB of memory and
# some CPU busy while the game runs, yet the game only talks to the steam process.
# Killing it would not help: Steam starts it again.
webhelpers() {
    for f in /proc/[0-9]*/comm; do
        case "$(cat "$f" 2>/dev/null)" in steamwebhelper*) p=${f#/proc/}; echo "${p%/comm}";; esac
    done
}
signal_webhelpers() { for p in $(webhelpers); do kill -"$1" "$p" 2>/dev/null; done; }
# If memory runs out, the kernel should kill the idle web helper first, not stall.
sacrifice_webhelpers() { for p in $(webhelpers); do echo 1000 > /proc/"$p"/oom_score_adj 2>/dev/null; done; }
freezing() { [ -n "$STEAM_APPID" ] && [ "${PONS_STEAM_FREEZE:-1}" = 1 ]; }

echo "Starting $NAME…"
if [ -z "$EXEC" ]; then
    # Steam starts the game with its own launch settings; follow the game's processes
    # by their install folder on the command line (the pattern sits in a file so this
    # grep does not find itself).
    PATTERN=/tmp/pons-game-$$.pattern
    printf '%s\n' "steamapps/common/$INSTALLDIR/" > "$PATTERN"
    game_running() { grep -l -s -a -F -f "$PATTERN" /proc/[0-9]*/cmdline >/dev/null; }
    pons-steam -applaunch "$STEAM_APPID" >/dev/null 2>&1 &
    waited=0
    until game_running; do
        sleep 2
        waited=$((waited + 2))
        if [ "$waited" -ge 180 ]; then
            rm -f "$PATTERN"
            echo "$NAME did not start within 3 minutes: try starting it from Steam." >&2
            exit 1
        fi
    done
    if freezing; then
        trap 'signal_webhelpers CONT; rm -f "$PATTERN"' EXIT INT TERM
        ( sleep 60; game_running && sacrifice_webhelpers && signal_webhelpers STOP ) &
    fi
    while game_running; do sleep 3; done
    rm -f "$PATTERN"
    exit 0
fi

cd "$GAME"
[ -n "$MAX_FPS" ] && export PONS_MAX_FPS="${PONS_MAX_FPS_GAME:-$MAX_FPS}"
export DISABLE_VK_LAYER_VALVE_steam_overlay_1=1
# File calls without proot stops (tools/compat/pons-fastpath.c): loading
# opens and checks tens of thousands of files. PONS_FASTPATH=0 turns it off.
FAST=/opt/pons/lib/libpons-fastpath.so
unset PONS_FASTPATH_ONLY # set for Steam (pons-steam); the game is not "steam"
if [ "${PONS_FASTPATH:-1}" = 1 ] && [ -n "${PONS_FASTPATH_ROOT:-}" ] && [ -f "$FAST" ]; then
    export LD_PRELOAD="$FAST${LD_PRELOAD:+:$LD_PRELOAD}"
fi


# shellcheck disable=SC2086  # ARGS is a word list by design
if freezing; then
    trap 'signal_webhelpers CONT' EXIT INT TERM
    "$EXEC" $ARGS "$@" &
    game=$!
    # Let the game sign in first; the freeze starts once it is running.
    ( sleep 60; kill -0 "$game" 2>/dev/null && sacrifice_webhelpers && signal_webhelpers STOP ) &
    wait "$game"
    status=$?
    signal_webhelpers CONT
    exit "$status"
fi
exec "$EXEC" $ARGS "$@"
