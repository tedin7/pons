#!/bin/sh
# pinguplay-game <profile> [game arguments...]
# Starts a game described by /opt/pinguplay/games/<profile>.conf: signs Steam in when
# the game needs it, runs the game with the profile's settings, and freezes Steam's
# web interface while the game runs (PINGUPLAY_STEAM_FREEZE=0 keeps it running).
set -u
PROFILE="${1:?uso: pinguplay-game <gioco> [argomenti]}"; shift
CONF="/opt/pinguplay/games/$PROFILE.conf"
[ -f "$CONF" ] || { echo "Gioco sconosciuto: $PROFILE" >&2; exit 1; }
NAME= STEAM_APPID= DIR= EXEC= ARGS= MAX_FPS=
. "$CONF"

STEAM="$HOME/.local/share/Steam"
GAME="$STEAM/steamapps/common/$DIR"
[ -x "$GAME/$EXEC" ] || { echo "$NAME non è installato: installalo da Steam." >&2; exit 1; }

if [ -n "$STEAM_APPID" ]; then
    LOG="$STEAM/logs/connection_log.txt"
    echo "Avvio Steam…"
    start_lines=$(wc -l < "$LOG" 2>/dev/null || echo 0)
    pinguplay-steam -silent > /tmp/pinguplay-steam.log 2>&1 &
    echo "Aspetto che il tuo account Steam sia collegato…"
    waited=0
    until tail -n +"$((start_lines + 1))" "$LOG" 2>/dev/null | grep -q "\[Logged On"; do
        sleep 2
        waited=$((waited + 2))
        if [ "$waited" -ge 300 ]; then
            echo "Steam non si è collegato in 5 minuti: apri Steam e fai l'accesso." >&2
            exit 1
        fi
    done
    export SteamAppId="$STEAM_APPID" SteamGameId="$STEAM_APPID"
fi

echo "Avvio $NAME…"
cd "$GAME"
[ -n "$MAX_FPS" ] && export PINGUPLAY_MAX_FPS="${PINGUPLAY_MAX_FPS_GAME:-$MAX_FPS}"
export DISABLE_VK_LAYER_VALVE_steam_overlay_1=1
# File calls without proot stops (tools/compat/pinguplay-fastpath.c): loading
# opens and checks tens of thousands of files. PINGUPLAY_FASTPATH=0 turns it off.
FAST=/opt/pinguplay/lib/libpinguplay-fastpath.so
if [ "${PINGUPLAY_FASTPATH:-1}" = 1 ] && [ -n "${PINGUPLAY_FASTPATH_ROOT:-}" ] && [ -f "$FAST" ]; then
    export LD_PRELOAD="$FAST${LD_PRELOAD:+:$LD_PRELOAD}"
fi

# Steam's web interface (steamwebhelper, a Chromium) keeps ~0.5 GB of memory and
# some CPU busy while the game runs, yet the game only talks to the steam process.
# Killing it would not help: Steam starts it again.
webhelpers() {
    for f in /proc/[0-9]*/comm; do
        case "$(cat "$f" 2>/dev/null)" in steamwebhelper*) p=${f#/proc/}; echo "${p%/comm}";; esac
    done
}
signal_webhelpers() { for p in $(webhelpers); do kill -"$1" "$p" 2>/dev/null; done; }

# shellcheck disable=SC2086  # ARGS is a word list by design
if [ -n "$STEAM_APPID" ] && [ "${PINGUPLAY_STEAM_FREEZE:-1}" = 1 ]; then
    trap 'signal_webhelpers CONT' EXIT INT TERM
    "$EXEC" $ARGS "$@" &
    game=$!
    # Let the game sign in first; the freeze starts once it is running.
    ( sleep 60; kill -0 "$game" 2>/dev/null && signal_webhelpers STOP ) &
    wait "$game"
    status=$?
    signal_webhelpers CONT
    exit "$status"
fi
exec "$EXEC" $ARGS "$@"
