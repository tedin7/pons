#!/bin/sh
# pons-prof <out-dir> <command...>
# Runs one workload for tools/dev/pp-prof.sh and records only what must come from
# inside: its output, its pid (the host samples /proc from outside proot, so the
# sampling itself adds no proot stops) and its wall/user/system time.
#   out/phases.txt   the workload's stdout (loadsim prints "phase ms count")
#   out/pid          the workload's pid, written as soon as it starts
#   out/times.txt    wall user system (seconds) exit-status
#   out/calls.txt    Box64 native calls per function (PONS_CALLSTATS)
set -u
OUT="${1:?out dir}"; shift
mkdir -p "$OUT"
rm -f "$OUT/pid" "$OUT/done"

# Box64 counts native calls only in blocks it translates now, not in cached ones.
export PONS_CALLSTATS="$OUT/calls.txt" BOX64_DYNACACHE="${BOX64_DYNACACHE:-0}" BOX64_LOG=0

start=$(date +%s.%N)
"$@" > "$OUT/phases.txt" 2> "$OUT/stderr.txt" &
pid=$!
echo "$pid" > "$OUT/pid"
wait "$pid"
status=$?
end=$(date +%s.%N)
# times: the shell's user/system, then its children's (the workload and all it waited for).
times | awk -v s="$start" -v e="$end" -v st="$status" 'NR == 2 {
    split($1, u, "m"); split($2, y, "m");
    printf "%.2f %.2f %.2f %d\n", e - s, u[1] * 60 + u[2], y[1] * 60 + y[2], st }' > "$OUT/times.txt"
touch "$OUT/done"
