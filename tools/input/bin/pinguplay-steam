#!/bin/sh
# Installs (first run) and starts Valve's native arm64 Steam client (public beta).
# x86 games launched by Steam are run through Box64.
set -eu
STEAM="$HOME/.local/share/Steam"
CDN=https://client-update.steamstatic.com
MANIFEST=steam_client_publicbeta_linuxarm64

# Valve's arm64 zip has a few entries with Windows separators ("steamrtarm64\libs\x")
# and stores no executable bits; Info-ZIP keeps both as-is. Repair after every unzip.
fix_steam_tree() {
    cd "$STEAM"
    for f in *\\*; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        target=$(printf '%s' "$f" | tr '\\' '/')
        if [ -d "$f" ] && [ ! -L "$f" ]; then
            mkdir -p "$target"; rmdir "$f" 2>/dev/null || true
        elif [ -L "$f" ] || [ -s "$f" ]; then
            mkdir -p "$(dirname "$target")"; mv -f "$f" "$target"
        else
            rm -f "$f"
        fi
    done
    find "$STEAM/steamrtarm64" -type f ! -perm -u+x | while read -r file; do
        case "$(head -c 4 "$file" 2>/dev/null)" in
            "$(printf '\177ELF')"|'#!'*) chmod +x "$file" ;;
        esac
    done
    cd - >/dev/null
}

if [ ! -f "$STEAM/steamrtarm64/steam" ]; then
    echo "Pinguplay: scarico il client Steam ARM (prima volta)…"
    mkdir -p "$STEAM/package" "$STEAM/steamrtarm64"
    curl -fsSL "$CDN/$MANIFEST" -o "$STEAM/package/$MANIFEST.manifest"
    # Pick the "file" and "sha2" lines of the bins_linuxarm64_linuxarm64 block.
    set -- $(awk '
        /^\t"bins_linuxarm64_linuxarm64"$/ { inside = 1; next }
        inside && /"file"/ { gsub(/"/, "", $2); file = $2 }
        inside && /"sha2"/ { gsub(/"/, "", $2); sha = $2 }
        inside && /^\t}/ { print file, sha; exit }
    ' "$STEAM/package/$MANIFEST.manifest")
    [ $# -eq 2 ] || { echo "Pinguplay: manifest Steam non riconosciuto" >&2; exit 1; }
    curl -fsSL "$CDN/$1" -o /tmp/steam-bins.zip
    echo "$2  /tmp/steam-bins.zip" | sha256sum -c - >/dev/null
    unzip -oq /tmp/steam-bins.zip -d "$STEAM"
    rm -f /tmp/steam-bins.zip
    echo publicbeta > "$STEAM/package/beta"
fi
fix_steam_tree
# Steam verifies its web UI's local connection with lsof, which cannot see sockets
# on Android: put Pinguplay's stand-in in its place (see pinguplay-lsof).
if [ "$(readlink /usr/bin/lsof 2>/dev/null)" != /opt/pinguplay/bin/pinguplay-lsof ]; then
    [ -e /usr/bin/lsof.real ] ||
        dpkg-divert --quiet --local --rename --divert /usr/bin/lsof.real --add /usr/bin/lsof
    ln -sf /opt/pinguplay/bin/pinguplay-lsof /usr/bin/lsof
fi
# The links Valve's steam.sh normally creates; the client refuses to start without them.
mkdir -p "$HOME/.steam"
ln -sfn "$STEAM" "$HOME/.steam/steam"
ln -sfn "$STEAM" "$HOME/.steam/root"

cd "$STEAM/steamrtarm64"
export STEAM_RUNTIME=1
# Box64 settings chosen on this device by pinguplay-transbench, if it has run.
[ -f "$HOME/.config/pinguplay/box64-tuned.env" ] && . "$HOME/.config/pinguplay/box64-tuned.env"
# MangoHud must stay off for the client itself: it crashes steamwebhelper's start.
# For an FPS overlay in a game, set the game's launch options to: MANGOHUD=1 %command%
export MANGOHUD=0
# Exit code 42 means "updated, start me again" (Valve's steam.sh loops the same way).
while :; do
    # The web UI's GPU process needs DRI3, which Xvfb lacks: draw menus in software.
    # Big Picture (-gamepadui) is one full-screen window, made for touch and pads.
    # Android blocks robust futex syscalls for apps; Steam's IPC engine needs them.
    LD_PRELOAD=/opt/pinguplay/lib/libpinguplay-robust.so${LD_PRELOAD:+:$LD_PRELOAD} \
        ./steam -no-cef-sandbox -cef-disable-gpu -cef-disable-gpu-compositing -gamepadui "$@" && exit 0 || code=$?
    [ "$code" -eq 42 ] || exit "$code"
    fix_steam_tree
done
