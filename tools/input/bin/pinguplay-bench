#!/bin/sh
# GPU checks inside Pinguplay's Linux: driver info, then Vulkan and OpenGL scores.
set -u
echo "== GPU"
vulkaninfo --summary 2>/dev/null | grep -E "deviceName|driverInfo|apiVersion" | sed 's/^ */  /'
echo "== Vulkan (vkmark)"
vkmark --winsys xcb -b vertex:duration=5 -b texture:duration=5 -b shading:duration=5 2>&1 \
    | grep -E "FPS|Score" | sed 's/^ */  /'
echo "== OpenGL via Zink (glmark2)"
glmark2 -b build:duration=5 -b texture:duration=5 -b shading:duration=5 2>&1 \
    | grep -E "FPS|Score" | sed 's/^ */  /'
